# ==========================================
# TEKY Learning Hub - Environment Variables
# ==========================================

# --- Frontend Portal & Backoffice ---
VITE_API_BASE_URL=/api
VITE_API_ORIGIN=http://localhost:5268
VITE_PUBLIC_ORIGIN=http://localhost:5173
VITE_PORTAL_ORIGIN=http://localhost:3000
VITE_BACKOFFICE_ORIGIN=http://localhost:3001
VITE_APP_TITLE=TEKY Learning Hub

# --- Backend API (.NET 9) ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=.\SQLEXPRESS;Database=Teky_Learning_Hub;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true;

# JWT Authentication
Jwt__Secret=TekyLearningHubSuperSecretKeyForDevelopment2026!MustBe32BytesOrLonger
Jwt__Issuer=TekyLearningHub
Jwt__Audience=TekyLearningHubUsers
Jwt__ExpiryMinutes=1440

