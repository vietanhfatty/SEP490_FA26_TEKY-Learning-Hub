# ==========================================
# TEKY Learning Hub - Environment Variables
# ==========================================

# --- Frontend Portal & Backoffice ---
VITE_API_BASE_URL=https://localhost:7001/api
VITE_APP_TITLE=TEKY Learning Hub

# --- Backend API (.NET 9) ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=localhost;Database=TekyLearningHubDb;Trusted_Connection=True;TrustServerCertificate=True;

# JWT Authentication
Jwt__Secret=TekyLearningHubSuperSecretKeyForDevelopment2026!MustBe32BytesOrLonger
Jwt__Issuer=TekyLearningHub
Jwt__Audience=TekyLearningHubUsers
Jwt__ExpiryMinutes=1440

